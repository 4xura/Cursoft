<Window x:Class="Cursoft.Views.ExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Cursoft.Controls"
        Title="{DynamicResource S.Export.Title}" Width="720" SizeToContent="Height"
        ResizeMode="NoResize" Style="{StaticResource Style.Window}" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="ExportFileName" TargetType="TextBox" BasedOn="{StaticResource Style.TextBox}">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
                <Border x:Name="Field" CornerRadius="12" Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="11,0">
                    <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Focusable="False"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Field" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="ExportChoice" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource Glass.Focus}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
                <Border x:Name="Row" Padding="4,3" Background="Transparent" CornerRadius="8">
                    <DockPanel>
                        <Border x:Name="Mark" DockPanel.Dock="Left" Width="18" Height="18" CornerRadius="5"
                                Margin="0,0,9,0" VerticalAlignment="Center" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                            <Path x:Name="Tick" Visibility="Collapsed" Data="M2,7 L5.5,10.5 L12.5,3.5" Stretch="Uniform" Width="11" Height="9"
                                  Stroke="White" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Border>
                        <ContentPresenter VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                        <Setter TargetName="Mark" Property="Background" Value="{DynamicResource Glass.Primary}"/></Trigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource Glass.ToolHover}"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Grid x:Name="RootGrid">
        <Border x:Name="GlassBackdrop" Background="{DynamicResource Glass.Art}" IsHitTestVisible="False"/>
        <Border Background="{DynamicResource Glass.Wash}" IsHitTestVisible="False"/>
        <Grid x:Name="ExportLayout" Margin="24">
            <Grid.LayoutTransform><ScaleTransform x:Name="UiScaleTransform"/></Grid.LayoutTransform>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,16">
                <Button DockPanel.Dock="Right" Style="{StaticResource Style.ToolButton}" Content="ⓘ"
                        AutomationProperties.Name="{DynamicResource S.Info.Title}" ToolTip="{DynamicResource S.Info.Tooltip}" Click="OnInfoButtonClick"/>
                <TextBlock Text="{DynamicResource S.Export.Title}" FontFamily="Segoe UI Semibold" FontSize="26" VerticalAlignment="Center"/>
            </DockPanel>
            <controls:GlassSurface x:Name="EmptyState" Grid.Row="1" CornerRadius="20" Padding="24,28">
                <StackPanel HorizontalAlignment="Center">
                    <Viewbox Width="34" Height="34" Margin="0,0,0,12">
                        <Path Stroke="{DynamicResource Brush.Accent}" StrokeThickness="1.6" StrokeLineJoin="Round"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M2,13 V19 Q2,21 4,21 H20 Q22,21 22,19 V13 M12,16 V2 M7,7 L12,2 L17,7"/>
                    </Viewbox>
                    <TextBlock FontSize="17" FontWeight="SemiBold" TextAlignment="Center" Text="{DynamicResource S.Export.Empty}"/>
                    <TextBlock Foreground="{DynamicResource Brush.TextDim}" TextWrapping="Wrap" TextAlignment="Center"
                               Margin="0,5,0,0" Text="{DynamicResource S.Export.EmptyHint}"/>
                </StackPanel>
            </controls:GlassSurface>
            <Grid x:Name="ExportFields" Grid.Row="1">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.12*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <controls:GlassSurface CornerRadius="20" Padding="16">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{DynamicResource S.Library}" FontSize="17" FontWeight="SemiBold"/>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,6,0,8">
                            <Button Style="{StaticResource Style.GhostButton}" Content="{DynamicResource S.SelectAll}" Click="OnSelectAllClick"/>
                            <Button Style="{StaticResource Style.GhostButton}" Content="{DynamicResource S.SelectNone}" Click="OnSelectNoneClick"/>
                        </StackPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MinHeight="60" MaxHeight="230">
                            <StackPanel x:Name="PresetRows"/>
                        </ScrollViewer>
                    </DockPanel>
                </controls:GlassSurface>
                <controls:GlassSurface Grid.Column="2" CornerRadius="20" Padding="16">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource S.Export.Format}" Margin="0,0,0,6" FontWeight="SemiBold"/>
                        <ComboBox x:Name="FormatChoice" Height="36" SelectedIndex="0" Style="{StaticResource Style.ComboBox}"
                                  AutomationProperties.Name="{DynamicResource S.Export.Format}">
                            <ComboBoxItem Content="{DynamicResource S.Export.FormatBundle}"/>
                            <ComboBoxItem Content="{DynamicResource S.Export.FormatZip}"/>
                            <ComboBoxItem Content="{DynamicResource S.Export.AsLinuxArchive}"/>
                            <ComboBoxItem Content="{DynamicResource S.Export.AsXcursorTheme}"/>
                        </ComboBox>
                        <TextBlock Text="{DynamicResource S.Export.Name}" Margin="0,18,0,6" FontWeight="SemiBold"/>
                        <TextBox x:Name="ExportNameBox" Height="36" Style="{StaticResource ExportFileName}" MaxLength="60"
                                 AutomationProperties.Name="{DynamicResource S.Export.Name}" ToolTip="{DynamicResource S.Export.Name.Tooltip}"/>
                        <TextBlock Text="{DynamicResource S.Export.Name.Tooltip}" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,0" Foreground="{DynamicResource Brush.TextDim}"/>
                        <TextBlock x:Name="SelectionCountText" Margin="0,18,0,0" Foreground="{DynamicResource Brush.TextDim}"/>
                    </StackPanel>
                </controls:GlassSurface>
            </Grid>
            <DockPanel Grid.Row="2" Margin="0,16,0,0" LastChildFill="False">
                <Button DockPanel.Dock="Left" Style="{StaticResource Style.GhostButton}" Padding="8,5"
                        Content="{DynamicResource S.Export.SaveGuide}" Click="OnGuideClick"/>
                <Button x:Name="ExportAction" DockPanel.Dock="Right" Style="{StaticResource Style.AccentButton}" Height="34" MinWidth="86"
                        Content="{DynamicResource S.Library.Export}" IsDefault="True" Click="OnExportClick"/>
                <Button x:Name="Dismiss" DockPanel.Dock="Right" Style="{StaticResource Style.Button}" Height="34" MinWidth="86"
                        Content="{DynamicResource S.Editor.Cancel}" IsCancel="True"/>
            </DockPanel>
        </Grid>
    </Grid>
</Window>

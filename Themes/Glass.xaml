<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Cursoft.Controls">
    <ImageBrush x:Key="Glass.Art" Stretch="UniformToFill">
        <ImageBrush.ImageSource>
            <BitmapImage UriSource="pack://application:,,,/Resources/Spectrum.jpg" DecodePixelWidth="1536" />
        </ImageBrush.ImageSource>
    </ImageBrush>
    <LinearGradientBrush x:Key="Glass.Edge" StartPoint="0,0" EndPoint=".8,1">
        <GradientStop Color="#B3B8F6FF" Offset="0"/><GradientStop Color="#466AABFF" Offset=".33"/>
        <GradientStop Color="#237C66D1" Offset=".70"/><GradientStop Color="#92CCAAFF" Offset="1"/>
    </LinearGradientBrush>
    <Pen x:Key="Glass.EdgePen" Brush="{StaticResource Glass.Edge}" Thickness="1"/>
    <LinearGradientBrush x:Key="Glass.HoverFilm" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2257DAEE" Offset="0"/><GradientStop Color="#057789DE" Offset=".46"/><GradientStop Color="#22CA93FF" Offset="1"/>
    </LinearGradientBrush>
    <RadialGradientBrush x:Key="Glass.Halo">
        <GradientStop Color="#385598BB" Offset="0"/><GradientStop Color="#315263B4" Offset=".55"/>
        <GradientStop Color="#1E9E79D2" Offset=".82"/><GradientStop Color="#007D52B0" Offset="1"/>
    </RadialGradientBrush>
    <LinearGradientBrush x:Key="Glass.Reflection" StartPoint=".2,0" EndPoint=".65,1">
        <GradientStop Color="#28FFFFFF" Offset="0"/><GradientStop Color="#06E8DCFF" Offset=".22"/>
        <GradientStop Color="#00FFFFFF" Offset=".55"/><GradientStop Color="#0FCCA7FF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Glass.Primary" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#EC167591" Offset="0"/><GradientStop Color="#EE344FBE" Offset=".43"/>
        <GradientStop Color="#EA7433BD" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Glass.Spectrum" StartPoint="0,.5" EndPoint="1,.5">
        <GradientStop Color="#40DDF4" Offset="0"/><GradientStop Color="#5F7FFF" Offset=".52"/><GradientStop Color="#B077FF" Offset="1"/>
    </LinearGradientBrush>
    <Style x:Key="Glass.Focus" TargetType="Control">
        <Setter Property="Template"><Setter.Value><ControlTemplate>
            <Border CornerRadius="12" Margin="1" BorderThickness="2" BorderBrush="{DynamicResource Brush.Accent}"/>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Style.Button" TargetType="Button">
        <Setter Property="controls:GlassHighlight.Enabled" Value="True"/>
        <Setter Property="Background" Value="{DynamicResource Glass.Pill}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Glass.Edge}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="15,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Glass.Focus}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
            <Grid RenderTransformOrigin=".5,.5">
                <Border CornerRadius="{Binding Path=(controls:GlassHighlight.Radius), RelativeSource={RelativeSource TemplatedParent}}" Background="{TemplateBinding Background}"/>
                <Border CornerRadius="{Binding Path=(controls:GlassHighlight.Radius), RelativeSource={RelativeSource TemplatedParent}}" Background="{DynamicResource Glass.Reflection}" IsHitTestVisible="False"/>
                <Border x:Name="Sheen" CornerRadius="{Binding Path=(controls:GlassHighlight.Radius), RelativeSource={RelativeSource TemplatedParent}}" Background="#25E1BFFF" Opacity="0" IsHitTestVisible="False"/>
                <Border CornerRadius="{Binding Path=(controls:GlassHighlight.Radius), RelativeSource={RelativeSource TemplatedParent}}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" IsHitTestVisible="False"/>
                <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                  RecognizesAccessKey="True" />
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Sheen" Property="Opacity" Value=".85"/></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter TargetName="Sheen" Property="Opacity" Value="1"/><Setter Property="Opacity" Value=".78"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".43"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style x:Key="Style.AccentButton" TargetType="Button" BasedOn="{StaticResource Style.Button}">
        <Setter Property="Background" Value="{DynamicResource Glass.Primary}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="Style.GhostButton" TargetType="Button" BasedOn="{StaticResource Style.Button}">
        <Setter Property="controls:GlassHighlight.Enabled" Value="False"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="9,6"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
            <Border x:Name="Glass" CornerRadius="16" Background="Transparent" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Glass" Property="Background" Value="{DynamicResource Glass.Pill}"/></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value=".7"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".4"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Style.ToggleCheckBox" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/><Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Glass.Focus}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal" Background="Transparent" VerticalAlignment="Center">
                <Border x:Name="Track" Width="34" Height="20" CornerRadius="10" Background="{DynamicResource Glass.Pill}"
                        BorderBrush="{StaticResource Glass.Edge}" BorderThickness="1">
                    <Ellipse x:Name="Knob" Width="14" Height="14" Margin="2" HorizontalAlignment="Left"
                             Fill="{DynamicResource Brush.TextDim}"/>
                </Border>
                <ContentPresenter VerticalAlignment="Center" Margin="8,0,0,0" RecognizesAccessKey="True"/>
            </StackPanel>
            <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Track" Property="Background" Value="{StaticResource Glass.Primary}"/>
                    <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                    <Setter TargetName="Knob" Property="Fill" Value="White"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".45"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Glass.Segment" TargetType="ListBoxItem">
        <Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="11,12"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
        <Setter Property="Margin" Value="2,3"/><Setter Property="FocusVisualStyle" Value="{StaticResource Glass.Focus}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Lens" CornerRadius="20" Padding="{TemplateBinding Padding}" Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
                <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Lens" Property="Background" Value="{DynamicResource Glass.Pill}"/></Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter TargetName="Lens" Property="Background" Value="{DynamicResource Glass.Selected}"/>
                    <Setter TargetName="Lens" Property="BorderBrush" Value="{DynamicResource Glass.Edge}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Style.ToolButton" TargetType="Button" BasedOn="{StaticResource Style.GhostButton}">
        <Setter Property="Width" Value="34"/><Setter Property="Height" Value="34"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
            <Border x:Name="Tool" Background="Transparent" CornerRadius="17">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tool" Property="Background" Value="{DynamicResource Glass.ToolHover}"/></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter TargetName="Tool" Property="Background" Value="{DynamicResource Glass.Selected}"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Style.ToolbarAction" TargetType="Button" BasedOn="{StaticResource Style.Button}">
        <Setter Property="controls:GlassHighlight.Radius" Value="20"/>
    </Style>
    <Style x:Key="Style.ToolbarAccentAction" TargetType="Button" BasedOn="{StaticResource Style.AccentButton}">
        <Setter Property="controls:GlassHighlight.Radius" Value="20"/>
    </Style>
</ResourceDictionary>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<Style TargetType="Slider" x:Key="Style.Slider">
		<Setter Property="Foreground" Value="{StaticResource Brush.Accent}" />
		<Setter Property="Background" Value="{StaticResource Brush.Border}" />
		<Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
		<Setter Property="Height" Value="24" />
		<Setter Property="Padding" Value="0" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Slider">
					<Grid>
						<Border Height="4"
								Background="{TemplateBinding Background}"
								CornerRadius="2"
								VerticalAlignment="Center"
								Margin="0,0,0,0" />
						<Track x:Name="PART_Track" VerticalAlignment="Center">
							<Track.DecreaseRepeatButton>
								<RepeatButton Command="Slider.DecreaseLarge">
									<RepeatButton.Template>
										<ControlTemplate TargetType="RepeatButton">
											<Border Height="4"
													Background="{DynamicResource Glass.Spectrum}"
													CornerRadius="2" />
										</ControlTemplate>
									</RepeatButton.Template>
								</RepeatButton>
							</Track.DecreaseRepeatButton>
							<Track.IncreaseRepeatButton>
								<RepeatButton Command="Slider.IncreaseLarge">
									<RepeatButton.Template>
										<ControlTemplate TargetType="RepeatButton">
											<Border Background="Transparent" />
										</ControlTemplate>
									</RepeatButton.Template>
								</RepeatButton>
							</Track.IncreaseRepeatButton>
							<Track.Thumb>
								<Thumb>
									<Thumb.Template>
										<ControlTemplate TargetType="Thumb">
                                        <Grid Width="26" Height="24" Background="Transparent">
                                            <Border x:Name="Lens" Height="14" CornerRadius="7" BorderThickness="1"
                                                    BorderBrush="{DynamicResource Glass.Edge}" VerticalAlignment="Center">
                                                <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,.9">
                                                    <GradientStop Color="#D7FAFF" Offset="0"/><GradientStop Color="#B6D3FF" Offset=".48"/><GradientStop Color="#D0BBFF" Offset="1"/>
                                                </LinearGradientBrush></Border.Background>
                                            </Border>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Lens" Property="Height" Value="17"/></Trigger>
                                            <Trigger Property="IsDragging" Value="True"><Setter TargetName="Lens" Property="BorderBrush" Value="White"/></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
									</Thumb.Template>
								</Thumb>
							</Track.Thumb>
						</Track>
					</Grid>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style TargetType="ScrollBar">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="Width" Value="10" />
		<Setter Property="MinWidth" Value="10" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="ScrollBar">
					<Grid Background="{TemplateBinding Background}">
						<Track x:Name="PART_Track" IsDirectionReversed="True" Margin="2">
							<Track.DecreaseRepeatButton>
								<RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0">
									<RepeatButton.Template>
										<ControlTemplate TargetType="RepeatButton">
											<Border Background="Transparent" />
										</ControlTemplate>
									</RepeatButton.Template>
								</RepeatButton>
							</Track.DecreaseRepeatButton>
							<Track.IncreaseRepeatButton>
								<RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0">
									<RepeatButton.Template>
										<ControlTemplate TargetType="RepeatButton">
											<Border Background="Transparent" />
										</ControlTemplate>
									</RepeatButton.Template>
								</RepeatButton>
							</Track.IncreaseRepeatButton>
							<Track.Thumb>
								<Thumb>
									<Thumb.Template>
										<ControlTemplate TargetType="Thumb">
											<Border x:Name="ThumbBd"
													Background="{StaticResource Brush.Border}"
													CornerRadius="4" />
											<ControlTemplate.Triggers>
												<Trigger Property="IsMouseOver" Value="True">
													<Setter TargetName="ThumbBd" Property="Background"
															Value="{StaticResource Brush.Accent}" />
												</Trigger>
											</ControlTemplate.Triggers>
										</ControlTemplate>
									</Thumb.Template>
								</Thumb>
							</Track.Thumb>
						</Track>
					</Grid>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
		<Style.Triggers>
			<Trigger Property="Orientation" Value="Horizontal">
				<Setter Property="Height" Value="10" />
				<Setter Property="MinHeight" Value="10" />
				<Setter Property="Width" Value="Auto" />
				<Setter Property="Template">
					<Setter.Value>
						<ControlTemplate TargetType="ScrollBar">
							<Grid Background="{TemplateBinding Background}">
								<Track x:Name="PART_Track" Margin="2">
									<Track.DecreaseRepeatButton>
										<RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0">
											<RepeatButton.Template>
												<ControlTemplate TargetType="RepeatButton">
													<Border Background="Transparent" />
												</ControlTemplate>
											</RepeatButton.Template>
										</RepeatButton>
									</Track.DecreaseRepeatButton>
									<Track.IncreaseRepeatButton>
										<RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0">
											<RepeatButton.Template>
												<ControlTemplate TargetType="RepeatButton">
													<Border Background="Transparent" />
												</ControlTemplate>
											</RepeatButton.Template>
										</RepeatButton>
									</Track.IncreaseRepeatButton>
									<Track.Thumb>
										<Thumb>
											<Thumb.Template>
												<ControlTemplate TargetType="Thumb">
													<Border x:Name="ThumbBd"
															Background="{StaticResource Brush.Border}"
															CornerRadius="4" />
													<ControlTemplate.Triggers>
														<Trigger Property="IsMouseOver" Value="True">
															<Setter TargetName="ThumbBd" Property="Background"
																	Value="{StaticResource Brush.Accent}" />
														</Trigger>
													</ControlTemplate.Triggers>
												</ControlTemplate>
											</Thumb.Template>
										</Thumb>
									</Track.Thumb>
								</Track>
							</Grid>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Trigger>
		</Style.Triggers>
	</Style>

	<Style TargetType="ScrollViewer">
		<Setter Property="Background" Value="Transparent" />
	</Style>

	<Style x:Key="Style.PencilButton" TargetType="Button">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="BorderThickness" Value="0" />
		<Setter Property="Cursor" Value="Hand" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<ContentPresenter Margin="2,2" />
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style x:Key="Style.PencilIcon" TargetType="TextBlock">
		<Setter Property="Text" Value="✏" />
		<Setter Property="FontSize" Value="10" />
		<Setter Property="Foreground" Value="{StaticResource Brush.TextDim}" />
		<Style.Triggers>
			<DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
				<Setter Property="Foreground" Value="{StaticResource Brush.Accent}" />
			</DataTrigger>
		</Style.Triggers>
	</Style>

</ResourceDictionary>
